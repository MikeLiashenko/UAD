func add_tree(p: Vector2, s: float, col: Color, conifer := false) -> void:
	var xf := Transform3D(Basis(Vector3.UP, rng.randf() * TAU) * Basis.from_scale(Vector3.ONE * s), Vector3(p.x, 0, p.y))
	if conifer:
		b_pines.add(xf, col)
	else:
		b_trees.add(xf, col)


func building_at(x: float, z: float) -> int:
	var k := _cell_key(int(floor((x + HALF) / FCELL)), int(floor((z + HALF) / FCELL)))
	if not fp_cells.has(k):
		return -1
	var best := -1
	var best_h := -1.0
	for i in fp_cells[k]:
		if fp_hidden[i] == 1:
			continue
		var c := fp_center[i]
		var dx := x - c.x
		var dz := z - c.z
		var ca := cos(fp_rot[i])
		var sa := sin(fp_rot[i])
		var lx := dx * ca + dz * sa
		var lz := -dx * sa + dz * ca
		var hs := fp_half[i]
		if absf(lx) <= hs.x and absf(lz) <= hs.y and c.y > best_h:
			best = i
			best_h = c.y
	return best


func ground_height(x: float, z: float) -> float:
	var bi := building_at(x, z)
	return fp_center[bi].y if bi >= 0 else 0.0


## Highest roof in the 3×3 cells around a point (for terrain-following flight).
func ceiling(x: float, z: float) -> float:
	var ix := int(floor((x + HALF) / FCELL))
	var iz := int(floor((z + HALF) / FCELL))
	var m := 0.0
	for dz in range(-1, 2):
		for dx in range(-1, 2):
			var cx := ix + dx
			var cz := iz + dz
			if cx >= 0 and cz >= 0 and cx < FN and cz < FN:
				m = maxf(m, hmax[cz * FN + cx])
	return m


