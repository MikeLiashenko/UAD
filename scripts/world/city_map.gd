	for m in [build_mat, lights_mat, traffic_mat, _ground_mat, neon_mat]:
		(m as ShaderMaterial).set_shader_parameter("blackouts", arr)


# --- Generation ----------------------------------------------------------------------------------
func _gen_zones() -> void:
	zones.resize(ZN * ZN)
	urb.resize(ZN * ZN)
	for iz in ZN:
		for ix in ZN:
			var x := -HALF + (ix + 0.5) * ZRES
			var z := -HALF + (iz + 0.5) * ZRES
			var zn := classify(x, z)
			zones[iz * ZN + ix] = zn
			urb[iz * ZN + ix] = _urban_level(x, z, zn)


func _gen_ground() -> void:
	var img := Image.create_empty(ZN, ZN, false, Image.FORMAT_RGBA8)
	for iz in ZN:
		for ix in ZN:
			var zn := zones[iz * ZN + ix]
			var u := urb[iz * ZN + ix]
			var c: Color
			match zn:
				GS.Zone.FOREST:
					c = Color(0.06, 0.13, 0.05)
				GS.Zone.WATER:
					c = Color(0.02, 0.05, 0.09)
				GS.Zone.CITY:
					c = Color(0.16, 0.16, 0.17)
				GS.Zone.SAND:
					c = Color(0.52, 0.47, 0.34)
				_:
					c = Color(0.19, 0.21, 0.12) if u == 0 else Color(0.17, 0.2, 0.12)
			c.a = 1.0 if u == 2 else (0.5 if u == 1 else 0.0)
			img.set_pixel(ix, iz, c)
	_ground_mat = Shaders.material(Shaders.GROUND)
	_ground_mat.set_shader_parameter("zone_tex", ImageTexture.create_from_image(img))
	_ground_mat.set_shader_parameter("half_size", HALF)
	var ds := PackedVector4Array()
	for d in city.districts:
		ds.append(Vector4(d[1], d[2], deg_to_rad(d[3]), d[4]))
	while ds.size() < Shaders.MAX_DISTRICTS:
		ds.append(Vector4(99999, 99999, 0, 50))
	_ground_mat.set_shader_parameter("districts", ds)
	_ground_mat.set_shader_parameter("district_count", city.districts.size())
	var pm := PlaneMesh.new()
	pm.size = Vector2(HALF * 2.0, HALF * 2.0)
	pm.subdivide_width = 20
	pm.subdivide_depth = 20
	Meshes.part(self, pm, _ground_mat)
	_gen_outer()


## The country beyond the map out to the horizon (Shaders.OUTER): fields, woods and villages, and
## the highways, railways and rivers of the map carried on from where they leave it.
func _gen_outer() -> void:
	var exits := PackedVector4Array()
	var dirs := PackedVector4Array()
	var add_exit := func(a: Vector2, b: Vector2, kind: int, w: float) -> void:
		# b is the end of a line, a the point before it: does the line run off the map there?
		if maxf(absf(b.x), absf(b.y)) < HALF * 0.8 or exits.size() >= 20:
			return
		var d := (b - a).normalized()
		if d == Vector2.ZERO:
			return
		exits.append(Vector4(b.x, b.y, kind, w))
		dirs.append(Vector4(d.x, d.y, float(exits.size()) * 1.7, 0.0))
	for r in city.rivers:
		var pts: PackedVector2Array = r.pts
		var ws: PackedFloat32Array = r.get("w", PackedFloat32Array())
		if pts.size() >= 2:
			add_exit.call(pts[1], pts[0], 2, ws[0] if ws.size() > 0 else 40.0)
			add_exit.call(pts[pts.size() - 2], pts[pts.size() - 1], 2, ws[ws.size() - 1] if ws.size() > 0 else 40.0)
	for r in city.roads:
		var pts: PackedVector2Array = r.pts
		if pts.size() >= 2:
			add_exit.call(pts[1], pts[0], 0, float(r.w))
			add_exit.call(pts[pts.size() - 2], pts[pts.size() - 1], 0, float(r.w))
	for r in city.rails:
		var pts: PackedVector2Array = r.pts
		if pts.size() >= 2:
			add_exit.call(pts[1], pts[0], 1, 3.0)
			add_exit.call(pts[pts.size() - 2], pts[pts.size() - 1], 1, 3.0)
	var mat := Shaders.material(Shaders.OUTER)
	var count := exits.size()
	while exits.size() < 20:
		exits.append(Vector4(99999, 99999, 0, 0))
		dirs.append(Vector4(1, 0, 0, 0))
	mat.set_shader_parameter("exits", exits)
	mat.set_shader_parameter("exit_dirs", dirs)
	mat.set_shader_parameter("exit_count", count)
	mat.set_shader_parameter("map_half", HALF)
	# a ring around the map, not a plane under it: two surfaces 0.4 m apart all over the city
	# fought for the depth buffer from a kilometre or two away and the fields flickered through
	# the streets. The ring tucks one metre under the map's edge, so no seam can open.
	var R := 22000.0
	var h := HALF - 1.0
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.set_normal(Vector3.UP)
	for q in [[-R, -R, R, -h], [-R, h, R, R], [-R, -h, -h, h], [h, -h, R, h]]:
		var a := Vector3(q[0], 0.0, q[1])
		var b := Vector3(q[2], 0.0, q[1])
		var c := Vector3(q[2], 0.0, q[3])
		var d := Vector3(q[0], 0.0, q[3])
		for v in [a, b, c, a, c, d]:
			st.add_vertex(v)
	var outer := st.commit()
	var mi := Meshes.part(self, outer, mat, Vector3(0, -0.4, 0))
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF


func _gen_forests() -> void:
	for iz in ZN:
		for ix in ZN:
			if zones[iz * ZN + ix] != GS.Zone.FOREST:
				continue
			var urban_park: bool = city.city_norm(-HALF + ix * ZRES, -HALF + iz * ZRES) < 1.05
			var k := 2 if rng.randf() < 0.35 else 1
			for j in k:
				var x := -HALF + (ix + rng.randf()) * ZRES
				var z := -HALF + (iz + rng.randf()) * ZRES
				if is_reserved(x, z, 2.0) or building_at(x, z) >= 0 or water_dist(x, z) < 2.0 or road_dist(x, z) < 1.0:
					continue
				var conifer := rng.randf() < (0.2 if urban_park else 0.75)
				var g := rng.randf_range(0.75, 1.1)
				var col := Color(0.09 * g, 0.24 * g, 0.08 * g) if conifer else Color(0.12 * g, 0.3 * g, 0.1 * g)
				add_tree(Vector2(x, z), rng.randf_range(1.0, 1.6) if conifer else rng.randf_range(0.9, 1.4), col, conifer)


## High-voltage lines leave every power plant for the edge of the map: lattice pylons with three
## sagging wires, skipped over houses, water and highways.
func _gen_power_lines() -> void:
	var steel := Color(0.5, 0.52, 0.55)
	var wire := Fx.solid(Color(0.25, 0.26, 0.28), 0.6, 0.5)
	for t in targets:
		if String(t.get("kind", "")) != "tpp":
			continue
		var c := Vector2(t.pos.x, t.pos.z)
		var a0 := rng.randf() * TAU
		for k in 2:
			var dir := Vector2.from_angle(a0 + k * (PI * 0.7 + rng.randf() * 0.6))
			var prev := Vector3.INF
			var d := 110.0
			while d < 1400.0:
				var p := c + dir * d
				d += 75.0
				if absf(p.x) > HALF - 20.0 or absf(p.y) > HALF - 20.0:
					break
				if water_dist(p.x, p.y) < 4.0 or road_dist(p.x, p.y) < 3.0 or building_at(p.x, p.y) >= 0 or is_reserved(p.x, p.y, 4.0):
					prev = Vector3.INF
					continue
				var h := 26.0
				for s in [-1.0, 1.0]:
					var q: Vector2 = p + Vector2(-dir.y, dir.x) * s * 2.2
					add_detail(Vector3(q.x, h * 0.5, q.y), Vector3(0.5, h, 0.5), 0.0, steel)
				var rot := atan2(dir.y, dir.x)
				add_detail(Vector3(p.x, h - 2.0, p.y), Vector3(0.4, 0.4, 11.0), -rot + PI * 0.5, steel)
				add_detail(Vector3(p.x, h - 6.0, p.y), Vector3(0.4, 0.4, 8.0), -rot + PI * 0.5, steel)
				add_footprint(p, Vector2(3, 3), 0.0, h, 1, "опора ЛЭП")
				var top := Vector3(p.x, h - 2.3, p.y)
				if prev != Vector3.INF:
					var side := Vector3(-dir.y, 0, dir.x)
					for w in [-4.5, 0.0, 4.5]:
						var a: Vector3 = prev + side * w
						var b: Vector3 = top + side * w
						var mid: Vector3 = (a + b) * 0.5 - Vector3(0, 2.2, 0)
						for seg in [[a, mid], [mid, b]]:
							var mi := MeshInstance3D.new()
							mi.mesh = Fx.cube(Vector3(0.12, 0.12, 1.0))
							mi.material_override = wire
							mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
							var sa: Vector3 = seg[0]
							var sb: Vector3 = seg[1]
							mi.transform = Transform3D(Basis.looking_at((sb - sa).normalized(), Vector3.UP) * Basis.from_scale(Vector3(1, 1, sa.distance_to(sb))), (sa + sb) * 0.5)
							add_child(mi)
				prev = top


## Parasols and changing cabins on the city beaches.
func _gen_beaches() -> void:
	var cols := [Color(0.9, 0.2, 0.2), Color(0.2, 0.5, 0.9), Color(0.95, 0.8, 0.2), Color(0.2, 0.7, 0.4), Color(0.95, 0.95, 0.9)]
	for iz in ZN:
		for ix in ZN:
			if zones[iz * ZN + ix] != GS.Zone.SAND or rng.randf() > 0.3:
				continue
			var x := -HALF + (ix + rng.randf()) * ZRES
			var z := -HALF + (iz + rng.randf()) * ZRES
			if water_dist(x, z) < 3.0 or building_at(x, z) >= 0 or city.city_norm(x, z) > 1.4:
				continue
			var c: Color = cols[rng.randi() % cols.size()]
			add_detail(Vector3(x, 1.1, z), Vector3(0.1, 2.2, 0.1), 0.0, Color(0.85, 0.85, 0.85))
			add_cyl(Vector3(x, 2.1, z), 1.3, 0.25, c)
			if rng.randf() < 0.4:
				add_detail(Vector3(x + 1.6, 0.15, z), Vector3(1.8, 0.3, 0.7), rng.randf() * PI, Color(0.9, 0.85, 0.7))


func _gen_labels() -> void:
	_labels = Node3D.new()
	add_child(_labels)
	for l in city.labels:
		_label(String(l[0]), l[1], l[3] if (l as Array).size() > 3 else Color(0.8, 1.0, 0.9, 0.85), int(l[2]))
	for d in city.districts:
		_label(String(d[0]), Vector3(d[1], 45, d[2]), Color(0.8, 1.0, 0.9, 0.85), 64)
	for t in targets:
		_label(String(t.name), t.pos + Vector3(0, 70, 0), Color(1.0, 0.55, 0.4, 0.9), 42, "◎ ")
	GS.language_changed.connect(refresh_labels)


func refresh_labels() -> void:
	for l in _labels.get_children():
		(l as Label3D).text = String(l.get_meta("prefix", "")) + GS.t(String(l.get_meta("key", "")))


func _label(text: String, pos: Vector3, color: Color, size: int, prefix := "") -> void:
	var l := Label3D.new()
	l.set_meta("key", text)
	l.set_meta("prefix", prefix)
	l.text = prefix + GS.t(text)
	l.font = GS.font
	l.font_size = size
	l.outline_size = 14
	l.modulate = color
	l.outline_modulate = Color(0, 0, 0, 0.7)
	l.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	l.no_depth_test = true
	l.pixel_size = 0.5
	l.position = pos
	_labels.add_child(l)


# --- Environment ------------------------------------------------------------------------------
func _setup_env() -> void:
	env = Environment.new()
	env.background_mode = Environment.BG_SKY
	var sky := Sky.new()
	_sky_mat = Shaders.material(Shaders.SKY)
	sky.sky_material = _sky_mat
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_exposure = 1.0
	env.tonemap_white = 6.0
	env.glow_enabled = true
	env.glow_intensity = 0.8
	env.glow_strength = 1.0
	env.glow_bloom = 0.05
	env.glow_hdr_threshold = 0.85
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_ADDITIVE
	env.adjustment_enabled = true
	env.fog_enabled = true
	# the sky draws its own horizon in the fog colour: the fog must not tint it again
	env.fog_sky_affect = 0.0
	_sky_mat.set_shader_parameter("sun_dir", _toward_light(SUN_DAY))
	_sky_mat.set_shader_parameter("moon_dir", _toward_light(SUN_NIGHT))
	_sky_mat.set_shader_parameter("cloud_cover", 0.3 + 0.3 * float(city.seed % 7) / 6.0)
	var we := WorldEnvironment.new()
	we.environment = env
	add_child(we)
	_sun = DirectionalLight3D.new()
	_sun.directional_shadow_max_distance = 900.0
	add_child(_sun)


## Where the directional light comes from (the sun by day, the moon by night): its rotation in
## degrees, and the unit vector pointing back at it for the sky.
const SUN_DAY := Vector3(-52, -35, 0)
const SUN_NIGHT := Vector3(-38, 155, 0)
## Haze on the horizon: day blue-grey, night the orange-brown of the city lights. Fog and sky
## share it, so the far land fades into the sky without a seam.
const HAZE_DAY := Color(0.7, 0.77, 0.85)
const HAZE_NIGHT := Color(0.095, 0.075, 0.082)


static func _toward_light(rot_deg: Vector3) -> Vector3:
	return Basis.from_euler(rot_deg * (PI / 180.0)) * Vector3(0, 0, 1)


## 0 low, 1 high, 2 ultra: shadows, glow and street life from high; the shaders read the same
## level (global "gfx") for clouds, stars, window interiors and water reflections.
func apply_quality(q: int) -> void:
	RenderingServer.global_shader_parameter_set("gfx", float(q))
	_sun.shadow_enabled = q >= 1
	env.glow_enabled = q >= 1
	get_viewport().msaa_3d = Viewport.MSAA_2X if q >= 1 else Viewport.MSAA_DISABLED
	if b_traffic:
		b_traffic.set_visible(q >= 1)
		b_cars.set_visible(q >= 1)
		b_people.set_visible(q >= 1)
		b_detail.set_visible(q >= 1)
		b_parked.set_visible(q >= 1)


func set_night(n: float) -> void:
	night = clampf(n, 0.0, 1.0)
	RenderingServer.global_shader_parameter_set("night", night)
	_sun.rotation_degrees = SUN_DAY.lerp(SUN_NIGHT, night)
	_sun.light_color = Color(1.0, 0.93, 0.8).lerp(Color(0.55, 0.65, 1.0), night)
	_sun.light_energy = lerpf(1.45, 0.3, night)
	env.ambient_light_color = Color(0.56, 0.62, 0.74).lerp(Color(0.15, 0.15, 0.25), night)
	env.ambient_light_energy = lerpf(0.6, 0.8, night)
	env.tonemap_exposure = lerpf(1.0, 1.3, night)
	var haze := HAZE_DAY.lerp(HAZE_NIGHT, night)
	env.fog_light_color = haze
	env.fog_density = lerpf(0.00017, 0.00042, night) * fog_scale
	env.adjustment_saturation = lerpf(1.12, 1.04, night)
	env.adjustment_contrast = lerpf(1.06, 1.1, night)
	env.glow_intensity = lerpf(0.45, 0.95, night)
	env.glow_bloom = lerpf(0.02, 0.07, night)
	if _sky_mat:
		_sky_mat.set_shader_parameter("haze_day", Vector3(HAZE_DAY.r, HAZE_DAY.g, HAZE_DAY.b))
		_sky_mat.set_shader_parameter("haze_night", Vector3(HAZE_NIGHT.r, HAZE_NIGHT.g, HAZE_NIGHT.b))


## 0 disables haze (overhead map view), 1 = normal atmosphere.
func set_fog_scale(s: float) -> void:
	fog_scale = s
	env.fog_enabled = s > 0.0
	set_night(night)


# --- Debug: top-down plan of the generated city (headless-friendly) ------------------------------------
## Writes a 1000×1000 PNG of the square (cx, cz, size): zones, water, highways, rails, buildings,
## bridges, reserves. The whole map by default (2 m per pixel).
func dump_plan(path: String, cx := 0.0, cz := 0.0, size := 2000.0) -> void:
	var n := 1000
	var k := size / n
	var ox := cx - size * 0.5
	var oz := cz - size * 0.5
	var img := Image.create_empty(n, n, false, Image.FORMAT_RGB8)
	for py in n:
		for px in n:
			var x := ox + (px + 0.5) * k
			var z := oz + (py + 0.5) * k
			var c: Color
			if water_dist(x, z) < 0.0:
				c = Color(0.15, 0.35, 0.7)
			else:
				match zone_at(x, z):
					GS.Zone.FOREST:
						c = Color(0.15, 0.4, 0.15)
					GS.Zone.CITY:
						c = Color(0.55, 0.55, 0.55)
					GS.Zone.SAND:
						c = Color(0.85, 0.78, 0.5)
					_:
						c = Color(0.62, 0.66, 0.42) if urban_at(x, z) == 0 else Color(0.7, 0.7, 0.5)
				if road_dist(x, z) < 0.0:
					c = Color(0.15, 0.15, 0.15)
			img.set_pixel(px, py, c)
	for i in fp_center.size():
		var cc := fp_center[i]
		var hs := fp_half[i]
		var col := Color(0.95, 0.35, 0.25) if fp_name.has(i) else Color(0.25, 0.22, 0.3).lerp(Color(1, 1, 0.9), clampf(cc.y / 90.0, 0.0, 1.0))
		if is_bridge(i):
			col = Color(1.0, 0.85, 0.1)
		var ca := cos(fp_rot[i])
		var sa := sin(fp_rot[i])
		var r := hs.length()
		for py in range(maxi(0, int((cc.z - r - oz) / k)), mini(n - 1, int((cc.z + r - oz) / k)) + 1):
			for px in range(maxi(0, int((cc.x - r - ox) / k)), mini(n - 1, int((cc.x + r - ox) / k)) + 1):
				var dx := ox + (px + 0.5) * k - cc.x
				var dz := oz + (py + 0.5) * k - cc.z
				var lx := dx * ca + dz * sa
				var lz := -dx * sa + dz * ca
				if absf(lx) <= hs.x and absf(lz) <= hs.y:
					img.set_pixel(px, py, col)
	for rv in _reserved:
		for q in 48:
			var a := TAU * q / 48.0
			var px := int((rv.x + cos(a) * rv.z - ox) / k)
			var py := int((rv.y + sin(a) * rv.z - oz) / k)
			if px >= 0 and py >= 0 and px < n and py < n:
				img.set_pixel(px, py, Color(1, 0, 1))
	for d in city.districts:
		var px := int((float(d[1]) - ox) / k)
		var py := int((float(d[2]) - oz) / k)
		for t in range(-4, 5):
			for q in [Vector2i(px + t, py), Vector2i(px, py + t)]:
				if q.x >= 0 and q.y >= 0 and q.x < n and q.y < n:
					img.set_pixel(q.x, q.y, Color(1, 1, 0))
	img.save_png(path)
	print("UAD: plan of %s saved to %s" % [city.id, path])
