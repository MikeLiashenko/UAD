extends Node3D
## Procedural city built from a CityDef (scripts/world/cities/<id>.gd): water (rivers, lakes, the
## sea, islands), forests and zones, highways and railways with their bridges, the registry of every
## building footprint so falling debris can hit any roof. City blocks are generated by CityGen,
## unique landmarks by the city file (with the Landmarks toolkit), moving life by Life.

const Fx = preload("res://scripts/core/fx.gd")
const Meshes = preload("res://scripts/core/meshes.gd")
const Shaders = preload("res://scripts/world/shaders.gd")
const Batch = preload("res://scripts/world/batch.gd")
const CityGen = preload("res://scripts/world/city_gen.gd")
const Landmarks = preload("res://scripts/world/landmarks.gd")
const Life = preload("res://scripts/world/life.gd")
const Cities = preload("res://scripts/world/cities.gd")

const HALF := 1000.0
const ZRES := 10.0
const ZN := 200
const FCELL := 20.0
const FN := 100

# --- Water distance field: a coarse grid everywhere, a fine one along the shores ------------------
const WHALF := 1100.0
const WC_RES := 20.0
const WC_N := 111
const WF_RES := 5.0
const WF_N := 441
## "Far from any water" (the field is not computed beyond this).
const FAR := 400.0
const COARSE_REACH := 170.0
const FINE_REACH := 24.0
# --- Road / rail clearance field -----------------------------------------------------------------
const RD_RES := 5.0
const RD_N := 401
const RD_REACH := 30.0

var city_id := "kyiv"
var city
var zones := PackedByteArray()
var urb := PackedByteArray()
var targets: Array = []
## Polylines drawn on the radar (rivers, the coast).
var radar_lines: Array = []
var night := 1.0
var fog_scale := 1.0
var env: Environment
var rng := RandomNumberGenerator.new()

var _wc := PackedFloat32Array()
var _wf := PackedFloat32Array()
var _rd := PackedFloat32Array()
## Bridges actually built: {"a", "b", "deck", "style", "fp", "name"}.
var built_bridges: Array = []
## Railway tracks for the trains: {"pts": PackedVector3Array, "len": PackedFloat32Array, "trains", "cars"}.
var tracks: Array = []
## Boat lanes in the water: PackedVector2Array each.
var lanes: Array = []

# --- Footprints: everything debris can land on ----------------------------------------
var fp_center := PackedVector3Array()   # x, roof height, z
var fp_half := PackedVector2Array()
var fp_rot := PackedFloat32Array()
var fp_kind := PackedByteArray()
var fp_damaged := PackedByteArray()
## x = box height, y = pitched-roof height (0 = none) — what a collapsed building is rebuilt from.
var fp_box := PackedVector2Array()
## How much of the building has come down, 0..CRUSH_MAX.
var fp_crush := PackedFloat32Array()
var fp_hidden := PackedByteArray()
var fp_ref: Array = []                 # Vector2i into b_build, or Vector2i(-1, -1)
var fp_roof: Array = []                # Vector2i into b_roof, or Vector2i(-1, -1)
var fp_name := {}
var fp_cells := {}
var hmax := PackedFloat32Array()
## Footprints of the road bridges (the fire crews drive over them).
var road_bridge_fp: Array = []

# --- Instanced geometry -------------------------------------------------------------------------
var b_build: Batch
var b_roof: Batch
var b_lights: Batch
var b_traffic: Batch
var b_trees: Batch
var b_pines: Batch
var b_props: Batch
var b_cyl: Batch
var b_cars: Batch
var b_people: Batch
## Small things that make a street look lived in: rooftop clutter, playgrounds, pylons, parasols.
var b_detail: Batch
var b_parked: Batch
var b_neon: Batch
var neon_mat: ShaderMaterial
## How many more smoking chimneys the city generator may light (particles are not free).
var smoke_budget := 24
## Pieces glued to a building (loggias, rooftop clutter, turrets): [batch, ref, transform, roof?]
## per footprint, so they come down with the floors and come back with the repairs.
var fp_attach := {}

const BILLBOARD := [Color(1.0, 0.35, 0.5), Color(0.35, 0.8, 1.0), Color(1.0, 0.85, 0.35), Color(0.6, 1.0, 0.5), Color(0.95, 0.95, 1.0)]
const CAR_PAINT := [Color(0.9, 0.9, 0.9), Color(0.08, 0.08, 0.09), Color(0.6, 0.62, 0.65), Color(0.6, 0.08, 0.06), Color(0.1, 0.22, 0.5), Color(0.35, 0.36, 0.38), Color(0.85, 0.75, 0.3), Color(0.15, 0.35, 0.2)]
const CLOTHES := [Color(0.15, 0.15, 0.2), Color(0.5, 0.1, 0.1), Color(0.2, 0.3, 0.55), Color(0.75, 0.7, 0.6), Color(0.3, 0.45, 0.3), Color(0.9, 0.9, 0.9), Color(0.55, 0.35, 0.2), Color(0.95, 0.8, 0.2)]

var build_mat: ShaderMaterial
var lights_mat: ShaderMaterial
var traffic_mat: ShaderMaterial
var blackouts: Array = []

var _noise := FastNoiseLite.new()
var _noise2 := FastNoiseLite.new()
var _reserved: Array = []
var _res_cells := {}
## Islands and zone-only areas of the city, checked by classify().
var _zone_areas: Array = []
var _sky_mat: ShaderMaterial
var _ground_mat: ShaderMaterial
var _water_mat: ShaderMaterial
var _sun: DirectionalLight3D
var _labels: Node3D
var _hidden: Array = []
var _hidden_fp: Array = []
var gen_ms := 0


func _ready() -> void:
	build()
	GS.state_changed.connect(_on_settings)


func _on_settings() -> void:
	apply_quality(int(GS.settings.quality))


func build() -> void:
	var t0 := Time.get_ticks_msec()
	_prof_t = Time.get_ticks_usec()
	city = Cities.get_def(city_id)
	city_id = city.id
	_zone_areas = city.islands + city.parks
	rng.seed = city.seed
	_noise.seed = city.noise_seed
	_noise.frequency = 0.003
	_noise2.seed = city.noise2_seed
	_noise2.frequency = 0.011
	hmax.resize(FN * FN)
	_setup_env()
	_make_batches()
	_step("setup")
	_gen_water_field()
	_step("water field")
	_gen_route_field()
	_gen_zones()
	_step("zones")
	_gen_ground()
	_gen_water_mesh()
	city.build_outer(self)
	_step("ground+water mesh")
	Landmarks.begin(self)
	city.build_landmarks(self)
	_step("landmarks")
	_gen_routes()
	_step("roads+rails")
	CityGen.build(self)
	_step("blocks")
	_gen_forests()
	_step("forests")
	_gen_power_lines()
	_gen_beaches()
	_step("details")
	for b in [b_build, b_roof, b_lights, b_traffic, b_trees, b_pines, b_props, b_cyl, b_cars, b_people, b_detail, b_parked, b_neon]:
		(b as Batch).build(self)
	var life := Life.new()
	life.map = self
	add_child(life)
	_gen_labels()
	_step("batches+life")
	_update_blackouts()
	apply_quality(int(GS.settings.quality))
	set_night(1.0)
	gen_ms = Time.get_ticks_msec() - t0
	print("UAD: %s generated in %d ms: %d buildings, %d roofs, %d lights, %d cars, %d people, %d trees, %d bridges, %d details, %d parked" % [
		city.id, gen_ms, fp_box.size(), b_roof.count(), b_lights.count(), b_cars.count(), b_people.count(), b_trees.count() + b_pines.count(), built_bridges.size(),
		b_detail.count() + b_build.count() - fp_box.size(), b_parked.count()])


var _prof_t := 0
var _prof := OS.get_cmdline_user_args().has("--genprof")


## Generation profile (run with -- --genprof).
func _step(what: String) -> void:
	if _prof:
		var now := Time.get_ticks_usec()
		print("UAD GEN %-18s %6.1f ms" % [what, (now - _prof_t) / 1000.0])
		_prof_t = now


func _make_batches() -> void:
	build_mat = Shaders.material(Shaders.BUILDING)
	lights_mat = Shaders.material(Shaders.LIGHTS)
	traffic_mat = Shaders.material(Shaders.TRAFFIC)
	b_build = Batch.new(Fx.cube(Vector3.ONE), build_mat, true, true)
	b_build.shadows = true
	var prism := PrismMesh.new()
	prism.size = Vector3.ONE
	b_roof = Batch.new(prism, build_mat, true, true)
	b_roof.shadows = true
	b_lights = Batch.new(Fx.quad(), lights_mat, true, true)
	b_lights.aabb_margin = 80.0
	b_lights.aabb_height = 450.0
	b_traffic = Batch.new(Fx.quad(), traffic_mat, true, true)
	b_traffic.aabb_margin = 320.0
	b_trees = Batch.new(Meshes.deciduous_mesh(), Fx.vcolor(), true, false)
	b_pines = Batch.new(Meshes.conifer_mesh(), Fx.vcolor(), true, false)
	b_props = Batch.new(Fx.cube(Vector3.ONE), Fx.vcolor(), true, false)
	var cyl := CylinderMesh.new()
	cyl.top_radius = 0.5
	cyl.bottom_radius = 0.5
	cyl.height = 1.0
	cyl.radial_segments = 12
	cyl.rings = 1
	b_cyl = Batch.new(cyl, Fx.vcolor(), true, false)
	b_cyl.shadows = true
	var car_mat := Shaders.material(Shaders.CAR_BODY)
	b_cars = Batch.new(Meshes.car_mesh(), car_mat, true, true)
	b_cars.aabb_margin = 320.0
	b_cars.aabb_height = 40.0
	b_people = Batch.new(Meshes.person_mesh(), Shaders.material(Shaders.PEOPLE), true, true)
	b_people.aabb_margin = 320.0
	b_people.aabb_height = 30.0
	b_detail = Batch.new(Fx.cube(Vector3.ONE), Fx.vcolor(), true, false)
	b_parked = Batch.new(Meshes.car_mesh(), Fx.solid_vcolor_metal(), true, false)
	neon_mat = Shaders.material(Shaders.NEON)
	b_neon = Batch.new(Fx.cube(Vector3.ONE), neon_mat, true, false)


# --- Water ------------------------------------------------------------------------------------------
## Every river is a chain of capsules; lakes and islands are ellipses; the sea is the city's own
## function. The exact distance is computed once into two grids, lookups are bilinear.
func _gen_water_field() -> void:
	var segs := []
	for r in city.rivers:
		var pts: PackedVector2Array = r.pts
		var ws: PackedFloat32Array = r.w
		for i in pts.size() - 1:
			segs.append([pts[i], pts[i + 1], ws[i], ws[i + 1]])
		if float(ws[0]) >= 8.0:
			radar_lines.append(pts)
	for c in city.radar_coast():
		radar_lines.append(c)
	_wc = _water_grid(WC_RES, WC_N, COARSE_REACH, segs, true)
	_wf = _water_grid(WF_RES, WF_N, FINE_REACH, segs, false)


func _water_grid(res: float, n: int, reach: float, segs: Array, coarse: bool) -> PackedFloat32Array:
	var g := PackedFloat32Array()
	g.resize(n * n)
	g.fill(FAR)
	for s in segs:
		var a: Vector2 = s[0]
		var b: Vector2 = s[1]
		var wa: float = s[2]
		var wb: float = s[3]
		var r := maxf(wa, wb) + reach
		var x0 := maxi(0, int(floor((minf(a.x, b.x) - r + WHALF) / res)))
		var x1 := mini(n - 1, int(ceil((maxf(a.x, b.x) + r + WHALF) / res)))
		var z0 := maxi(0, int(floor((minf(a.y, b.y) - r + WHALF) / res)))
		var z1 := mini(n - 1, int(ceil((maxf(a.y, b.y) + r + WHALF) / res)))
		var abx := b.x - a.x
		var abz := b.y - a.y
		var l2 := maxf(abx * abx + abz * abz, 0.0001)
		for iz in range(z0, z1 + 1):
			var z := -WHALF + iz * res
			var row := iz * n
			for ix in range(x0, x1 + 1):
				var x := -WHALF + ix * res
				var t := clampf(((x - a.x) * abx + (z - a.y) * abz) / l2, 0.0, 1.0)
				var dx := a.x + abx * t - x
				var dz := a.y + abz * t - z
				var d := sqrt(dx * dx + dz * dz) - (wa + (wb - wa) * t)
				if d < g[row + ix]:
					g[row + ix] = d
	for l in city.lakes:
		_ellipse_into(g, res, n, reach, l, false)
	if city.has_sea and coarse:
		for iz in n:
			var z := -WHALF + iz * res
			for ix in n:
				var d: float = city.sea_dist(-WHALF + ix * res, z)
				if d < g[iz * n + ix]:
					g[iz * n + ix] = d
	elif city.has_sea:
		# the fine grid only needs the sea along the coast: coarse cells that straddle it
		var sub := int(WC_RES / res)
		for cz in WC_N - 1:
			for cx in WC_N - 1:
				var i := cz * WC_N + cx
				var mn := minf(minf(_wc[i], _wc[i + 1]), minf(_wc[i + WC_N], _wc[i + WC_N + 1]))
				var mx := maxf(maxf(_wc[i], _wc[i + 1]), maxf(_wc[i + WC_N], _wc[i + WC_N + 1]))
				if mn > 60.0 or mx < -60.0:
					continue
				for fz in sub + 1:
					var iz := cz * sub + fz
					var z := -WHALF + iz * res
					for fx in sub + 1:
						var ix := cx * sub + fx
						var d: float = city.sea_dist(-WHALF + ix * res, z)
						if d < g[iz * n + ix]:
							g[iz * n + ix] = d
	for isl in city.islands:
		_ellipse_into(g, res, n, reach, isl, true)
	return g


## Lakes join the water (min), islands cut land out of it (max with the negated distance).
func _ellipse_into(g: PackedFloat32Array, res: float, n: int, reach: float, e: Array, island: bool) -> void:
	var cx := float(e[0])
	var cz := float(e[1])
	var rx := float(e[2])
	var rz := float(e[3])
	var rot := deg_to_rad(float(e[4]) if e.size() > 4 else 0.0)
	var ca := cos(rot)
	var sa := sin(rot)
	var rm := minf(rx, rz)
	var r := maxf(rx, rz) + reach
	var x0 := maxi(0, int(floor((cx - r + WHALF) / res)))
	var x1 := mini(n - 1, int(ceil((cx + r + WHALF) / res)))
	var z0 := maxi(0, int(floor((cz - r + WHALF) / res)))
	var z1 := mini(n - 1, int(ceil((cz + r + WHALF) / res)))
	for iz in range(z0, z1 + 1):
		var z := -WHALF + iz * res - cz
		for ix in range(x0, x1 + 1):
			var x := -WHALF + ix * res - cx
			var u := (x * ca + z * sa) / rx
			var v := (-x * sa + z * ca) / rz
			var d := (sqrt(u * u + v * v) - 1.0) * rm
			var i := iz * n + ix
			if island:
				if g[i] < FAR * 0.5 and -d > g[i]:
					g[i] = -d
			elif d < g[i]:
				g[i] = d


func _coarse_at(x: float, z: float) -> float:
	var fx := clampf((x + WHALF) / WC_RES, 0.0, WC_N - 1.001)
	var fz := clampf((z + WHALF) / WC_RES, 0.0, WC_N - 1.001)
	var ix := int(fx)
	var iz := int(fz)
	var tx := fx - ix
	var tz := fz - iz
	var i := iz * WC_N + ix
	return lerpf(lerpf(_wc[i], _wc[i + 1], tx), lerpf(_wc[i + WC_N], _wc[i + WC_N + 1], tx), tz)


## Signed distance to water (negative = in the water).
func water_dist(x: float, z: float) -> float:
	var fx := (x + WHALF) / WF_RES
	var fz := (z + WHALF) / WF_RES
	var ix := int(floor(fx))
	var iz := int(floor(fz))
	if ix < 0 or iz < 0 or ix >= WF_N - 1 or iz >= WF_N - 1:
		return FAR
	var i := iz * WF_N + ix
	var a := _wf[i]
	var b := _wf[i + 1]
	var c := _wf[i + WF_N]
	var d := _wf[i + WF_N + 1]
	if a < FINE_REACH and b < FINE_REACH and c < FINE_REACH and d < FINE_REACH:
		var tx := fx - ix
		var tz := fz - iz
		return lerpf(lerpf(a, b, tx), lerpf(c, d, tx), tz)
	return _coarse_at(x, z)


## Marching squares over the fine grid along the shores, whole quads over open water.
func _gen_water_mesh() -> void:
	_water_mat = Shaders.material(Shaders.WATER)
	var verts := PackedVector3Array()
	var y := 0.35
	var sub := int(WC_RES / WF_RES)
	for cz in WC_N - 1:
		var run_start := -1
		for cx in WC_N:
			var full := false
			var edge := false
			if cx < WC_N - 1:
				var i := cz * WC_N + cx
				var v0 := _wc[i]
				var v1 := _wc[i + 1]
				var v2 := _wc[i + WC_N + 1]
				var v3 := _wc[i + WC_N]
				var mx := maxf(maxf(v0, v1), maxf(v2, v3))
				var mn := minf(minf(v0, v1), minf(v2, v3))
				full = mx < -15.0
				edge = not full and mn < 15.0
			if full and run_start < 0:
				run_start = cx
			elif not full and run_start >= 0:
				_quad(verts, -WHALF + run_start * WC_RES, -WHALF + cx * WC_RES, -WHALF + cz * WC_RES, -WHALF + (cz + 1) * WC_RES, y)
				run_start = -1
			if edge:
				for fz in sub:
					for fx in sub:
						_cell(verts, cx * sub + fx, cz * sub + fz, y)
	if verts.is_empty():
		return
	var norms := PackedVector3Array()
	norms.resize(verts.size())
	norms.fill(Vector3.UP)
	# how far from the bank (the shader makes the shallows lighter and foams the shore line)
	var cols := PackedColorArray()
	cols.resize(verts.size())
	for i in verts.size():
		var s := clampf(-water_dist(verts[i].x, verts[i].z) / 30.0, 0.0, 1.0)
		cols[i] = Color(s, s, s, 1.0)
	var a := []
	a.resize(Mesh.ARRAY_MAX)
	a[Mesh.ARRAY_VERTEX] = verts
	a[Mesh.ARRAY_NORMAL] = norms
	a[Mesh.ARRAY_COLOR] = cols
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, a)
	var mi := Meshes.part(self, am, _water_mat)
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF


## Open-water quads overlap their neighbours a little: rows of different length and the finer
## shore cells meet in T-junctions, which would otherwise show as hairline cracks.
func _quad(verts: PackedVector3Array, x0: float, x1: float, z0: float, z1: float, y: float) -> void:
	x0 -= 0.3
	x1 += 0.3
	z0 -= 0.3
	z1 += 0.3
	verts.append_array([Vector3(x0, y, z0), Vector3(x1, y, z0), Vector3(x1, y, z1), Vector3(x0, y, z0), Vector3(x1, y, z1), Vector3(x0, y, z1)])


## Fine-grid corner value for the shore mesh. Points the fine grid skipped are well inland (every
## point in or near the water was computed), so only the sign matters there.
func _fine_v(ix: int, iz: int) -> float:
	var v := _wf[iz * WF_N + ix]
	if v >= FAR * 0.5:
		# deep sea is never refined: trust the coarse grid there
		return minf(FINE_REACH, _coarse_at(-WHALF + ix * WF_RES, -WHALF + iz * WF_RES)) if city.has_sea else FINE_REACH
	return v


func _cell(verts: PackedVector3Array, ix: int, iz: int, y: float) -> void:
	var v := [_fine_v(ix, iz), _fine_v(ix + 1, iz), _fine_v(ix + 1, iz + 1), _fine_v(ix, iz + 1)]
	if v[0] >= 0.0 and v[1] >= 0.0 and v[2] >= 0.0 and v[3] >= 0.0:
		return
	var x0 := -WHALF + ix * WF_RES
	var z0 := -WHALF + iz * WF_RES
	var p := [Vector2(x0, z0), Vector2(x0 + WF_RES, z0), Vector2(x0 + WF_RES, z0 + WF_RES), Vector2(x0, z0 + WF_RES)]
	var poly := []
	for k in 4:
		var k2 := (k + 1) % 4
		var a: float = v[k]
		var b: float = v[k2]
		if a < 0.0:
			poly.append(p[k])
		if (a < 0.0) != (b < 0.0):
			poly.append((p[k] as Vector2).lerp(p[k2], a / (a - b)))
	for k in range(1, poly.size() - 1):
		var q0: Vector2 = poly[0]
		var q1: Vector2 = poly[k]
		var q2: Vector2 = poly[k + 1]
		verts.append_array([Vector3(q0.x, y, q0.y), Vector3(q1.x, y, q1.y), Vector3(q2.x, y, q2.y)])


func is_sea(x: float, z: float) -> bool:
	return city.has_sea and city.sea_dist(x, z) < 0.0


# --- Zones ----------------------------------------------------------------------------------------------
func classify(x: float, z: float) -> int:
	var wd := water_dist(x, z)
	if wd < 0.0:
		return GS.Zone.WATER
	var n := _noise.get_noise_2d(x, z)
	var hook: int = city.zone_hook(self, x, z, wd, n)
	if hook >= 0:
		return hook
	for isl in _zone_areas:
		if _in_ellipse(x, z, isl, 1.0):
			var iz := int(isl[5]) if (isl as Array).size() > 5 else GS.Zone.FOREST
			if iz == GS.Zone.FOREST and wd < 9.0:
				return GS.Zone.SAND
			return iz
	if city.beach_width > 0.0 and wd < city.beach_width and city.city_norm(x, z) > 0.3:
		return GS.Zone.SAND
	for f in city.forests:
		if Vector2(x - float(f[0]), z - float(f[1])).length() < float(f[2]) + n * float(f[3]):
			return GS.Zone.FOREST
	var cn: float = city.city_norm(x, z)
	if cn < 1.0 + n * 0.22:
		if _noise2.get_noise_2d(x, z) > city.park_threshold:
			return GS.Zone.FOREST # city parks
		return GS.Zone.CITY
	if cn > 1.25 and n > 0.1:
		return GS.Zone.FOREST
	return GS.Zone.FIELD


func _in_ellipse(x: float, z: float, e: Array, k: float) -> bool:
	var rot := deg_to_rad(float(e[4]) if e.size() > 4 else 0.0)
	var dx := x - float(e[0])
	var dz := z - float(e[1])
	var u := (dx * cos(rot) + dz * sin(rot)) / (float(e[2]) * k)
	var v := (-dx * sin(rot) + dz * cos(rot)) / (float(e[3]) * k)
	return u * u + v * v < 1.0


func noise_at(x: float, z: float) -> float:
	return _noise.get_noise_2d(x, z)


func _urban_level(x: float, z: float, zone: int) -> int:
	if zone == GS.Zone.CITY:
		return 2
	if zone == GS.Zone.FIELD and city.city_norm(x, z) < 1.34 + _noise.get_noise_2d(x, z) * 0.2:
		return 1
	return 0


func zone_at(x: float, z: float) -> int:
	var ix := int((x + HALF) / ZRES)
	var iz := int((z + HALF) / ZRES)
	if ix < 0 or iz < 0 or ix >= ZN or iz >= ZN:
		return GS.Zone.WATER if is_sea(x, z) else GS.Zone.FIELD
	return zones[iz * ZN + ix]


func urban_at(x: float, z: float) -> int:
	var ix := int((x + HALF) / ZRES)
	var iz := int((z + HALF) / ZRES)
	if ix < 0 or iz < 0 or ix >= ZN or iz >= ZN:
		return 0
	return urb[iz * ZN + ix]


## Base location type for a map point, or -1 when the base can't be placed there.
func location_at(x: float, z: float) -> int:
	if absf(x) > HALF - 60.0 or absf(z) > HALF - 60.0:
		return -1
	var zn := classify(x, z)
	if zn == GS.Zone.WATER or water_dist(x, z) < 12.0:
		return -1
	if is_reserved(x, z, 30.0) or road_dist(x, z) < 14.0:
		return -1
	if water_dist(x, z) < 90.0:
		return GS.Loc.RIVER
	if zn == GS.Zone.FOREST:
		var city_hits := 0
		for i in 16:
			var a := TAU * i / 16.0
			if zone_at(x + cos(a) * 130.0, z + sin(a) * 130.0) == GS.Zone.CITY:
				city_hits += 1
		return GS.Loc.CITY if city_hits >= 5 else GS.Loc.FOREST
	if zn == GS.Zone.CITY:
		return GS.Loc.CITY
	return GS.Loc.FIELD


func reserve(x: float, z: float, r: float) -> void:
	var rv := Vector3(x, z, r)
	_reserved.append(rv)
	# spatial hash: every 100 m cell the circle (plus the largest query radius) touches
	var reach := r + 45.0
	for cz in range(int(floor((z - reach) / 100.0)), int(floor((z + reach) / 100.0)) + 1):
		for cx in range(int(floor((x - reach) / 100.0)), int(floor((x + reach) / 100.0)) + 1):
			var k := cz * 1000 + cx
			if not _res_cells.has(k):
				_res_cells[k] = []
			(_res_cells[k] as Array).append(rv)


func is_reserved(x: float, z: float, r: float) -> bool:
	if r > 45.0:
		for rv in _reserved:
			if Vector2(x - rv.x, z - rv.y).length() < rv.z + r:
				return true
		return false
	var k := int(floor(z / 100.0)) * 1000 + int(floor(x / 100.0))
	if not _res_cells.has(k):
		return false
	for rv in _res_cells[k]:
		if Vector2(x - rv.x, z - rv.y).length() < rv.z + r:
			return true
	return false


# --- Highways & railways ---------------------------------------------------------------------------------
func _gen_route_field() -> void:
	_rd.resize(RD_N * RD_N)
	_rd.fill(RD_REACH)
	var list := []
	for r in city.roads:
		list.append([r.pts, float(r.w) + 1.0])
	for r in city.rails:
		list.append([r.pts, 4.0])
	for item in list:
		var pts: PackedVector2Array = item[0]
		var w: float = item[1]
		for i in pts.size() - 1:
			var a: Vector2 = pts[i]
			var b: Vector2 = pts[i + 1]
			var r := w + RD_REACH
			var x0 := maxi(0, int(floor((minf(a.x, b.x) - r + HALF) / RD_RES)))
			var x1 := mini(RD_N - 1, int(ceil((maxf(a.x, b.x) + r + HALF) / RD_RES)))
			var z0 := maxi(0, int(floor((minf(a.y, b.y) - r + HALF) / RD_RES)))
			var z1 := mini(RD_N - 1, int(ceil((maxf(a.y, b.y) + r + HALF) / RD_RES)))
			var abx := b.x - a.x
			var abz := b.y - a.y
			var l2 := maxf(abx * abx + abz * abz, 0.0001)
			for iz in range(z0, z1 + 1):
				var z := -HALF + iz * RD_RES
				for ix in range(x0, x1 + 1):
					var x := -HALF + ix * RD_RES
					var t := clampf(((x - a.x) * abx + (z - a.y) * abz) / l2, 0.0, 1.0)
					var dx := a.x + abx * t - x
					var dz := a.y + abz * t - z
					var d := sqrt(dx * dx + dz * dz) - w
					if d < _rd[iz * RD_N + ix]:
						_rd[iz * RD_N + ix] = d


## Distance to the edge of the nearest highway or railway (negative = on it).
func road_dist(x: float, z: float) -> float:
	var fx := (x + HALF) / RD_RES
	var fz := (z + HALF) / RD_RES
	var ix := int(floor(fx))
	var iz := int(floor(fz))
	if ix < 0 or iz < 0 or ix >= RD_N - 1 or iz >= RD_N - 1:
		return RD_REACH
	var i := iz * RD_N + ix
	var tx := fx - ix
	var tz := fz - iz
	return lerpf(lerpf(_rd[i], _rd[i + 1], tx), lerpf(_rd[i + RD_N], _rd[i + RD_N + 1], tx), tz)


## Splits a polyline into runs on land and over water: [[from_s, to_s, wet], ...] (s = metres).
func _wet_runs(pts: PackedVector2Array) -> Array:
	var out := []
	var s := 0.0
	var cur_wet := water_dist(pts[0].x, pts[0].y) < 0.0
	var start := 0.0
	for i in pts.size() - 1:
		var a: Vector2 = pts[i]
		var b: Vector2 = pts[i + 1]
		var l := a.distance_to(b)
		var k := maxi(1, int(ceil(l / 4.0)))
		for j in range(1, k + 1):
			var p := a.lerp(b, float(j) / k)
			var wet := water_dist(p.x, p.y) < 0.0
			var sj := s + l * float(j) / k
			if wet != cur_wet:
				out.append([start, sj, cur_wet])
				start = sj
				cur_wet = wet
		s += l
	out.append([start, s, cur_wet])
	return out


## Water crossings along a polyline as [from_s, to_s] including 34 m of approach on each bank.
## Crossings with less than 160 m of land between them (a narrow island) become one bridge.
func _crossings(pts: PackedVector2Array) -> Array:
	var out := []
	for run in _wet_runs(pts):
		if not bool(run[2]) or float(run[1]) - float(run[0]) < 6.0:
			continue
		var s0 := maxf(float(run[0]) - 34.0, 0.0)
		var s1 := float(run[1]) + 34.0
		if not out.is_empty() and s0 - float(out[out.size() - 1][1]) < 92.0:
			out[out.size() - 1][1] = s1
		else:
			out.append([s0, s1])
	return out


func _point_at(pts: PackedVector2Array, s: float) -> Vector2:
	var acc := 0.0
	for i in pts.size() - 1:
		var l := pts[i].distance_to(pts[i + 1])
		if acc + l >= s:
			return pts[i].lerp(pts[i + 1], (s - acc) / maxf(l, 0.001))
		acc += l
	return pts[pts.size() - 1]


func _gen_routes() -> void:
	var st := {"v": PackedVector3Array(), "c": PackedColorArray()}
	for r in city.roads:
		_build_road(r, st)
	for r in city.rails:
		_build_rail(r, st)
	for b in city.bridges:
		var bd: Dictionary = Landmarks.bridge(self, b.a, b.b, String(b.style), String(b.name), bool(b.get("target", false)))
		built_bridges.append(bd)
		if String(b.style) != "rail" and String(b.style) != "pedestrian":
			road_bridge_fp.append(int(bd.fp))
	var verts: PackedVector3Array = st.v
	if verts.is_empty():
		return
	var norms := PackedVector3Array()
	norms.resize(verts.size())
	norms.fill(Vector3.UP)
	var a := []
	a.resize(Mesh.ARRAY_MAX)
	a[Mesh.ARRAY_VERTEX] = verts
	a[Mesh.ARRAY_NORMAL] = norms
	a[Mesh.ARRAY_COLOR] = st.c
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, a)
	var mi := Meshes.part(self, am, Shaders.material(Shaders.FLAT))
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF


## A flat strip of width 2·w along a→b at height y (clockwise from above, as the ground).
func _strip(st: Dictionary, a: Vector2, b: Vector2, w: float, y: float, col: Color) -> void:
	var d := (b - a).normalized()
	var s := Vector2(-d.y, d.x) * w
	var p0 := a - s
	var p1 := a + s
	var p2 := b + s
	var p3 := b - s
	# keep the winding clockwise seen from above whatever the direction
	var cross := (p1 - p0).x * (p2 - p0).y - (p1 - p0).y * (p2 - p0).x
	var q := [p0, p1, p2, p3] if cross > 0.0 else [p0, p3, p2, p1]
	var v: PackedVector3Array = st.v
	var c: PackedColorArray = st.c
	for i in [0, 1, 2, 0, 2, 3]:
		var p: Vector2 = q[i]
		v.append(Vector3(p.x, y, p.y))
		c.append(col)
	st.v = v
	st.c = c


func _build_road(r: Dictionary, st: Dictionary) -> void:
	var pts: PackedVector2Array = r.pts
	var w: float = r.w
	var specs: Array = r.get("bridges", [])
	var asphalt := Color(0.07, 0.07, 0.075)
	var paint := Color(0.75, 0.75, 0.7)
	var total := 0.0
	for i in pts.size() - 1:
		total += pts[i].distance_to(pts[i + 1])
	# one bridge per water crossing, the land runs between them get the asphalt
	var land := []
	var at := 0.0
	var cr := _crossings(pts)
	for k in cr.size():
		var spec: Dictionary = specs[k] if k < specs.size() else {}
		var bd: Dictionary = Landmarks.bridge(self, _point_at(pts, cr[k][0]), _point_at(pts, cr[k][1]), String(spec.get("style", "girder")), String(spec.get("name", "мост")), bool(spec.get("target", false)))
		built_bridges.append(bd)
		road_bridge_fp.append(int(bd.fp))
		land.append([at, float(cr[k][0]) + 34.0])
		at = float(cr[k][1]) - 34.0
	land.append([at, total])
	for run in land:
		var s0: float = run[0]
		var s1: float = run[1]
		if s1 - s0 < 5.0:
			continue
		# land: asphalt, markings, lamps, traffic, pedestrians
		var s := s0
		var seg_a := _point_at(pts, s)
		var run_a := seg_a
		var run_dir := Vector2.ZERO
		var lamp_s := s0 + 12.0
		while s < s1 - 0.5:
			var s2 := minf(s + 10.0, s1)
			var seg_b := _point_at(pts, s2)
			if seg_a.distance_to(seg_b) > 0.3:
				_strip(st, seg_a, seg_b, w, 0.12, asphalt)
				_strip(st, seg_a, seg_b, 0.18, 0.2, paint)
				var dn := (seg_b - seg_a).normalized()
				var side := Vector2(-dn.y, dn.x)
				for sg in [-1.0, 1.0]:
					_strip(st, seg_a + side * sg * (w - 0.7), seg_b + side * sg * (w - 0.7), 0.12, 0.2, paint)
				if run_dir == Vector2.ZERO:
					run_dir = dn
				elif run_dir.angle_to(dn) > 0.12 or run_a.distance_to(seg_b) > 220.0:
					add_traffic(run_a, seg_a, 1.1)
					add_people(run_a, seg_a, w + 2.5)
					run_a = seg_a
					run_dir = dn
				while lamp_s < s2:
					var lp := _point_at(pts, lamp_s)
					for sg in [-1.0, 1.0]:
						var q: Vector2 = lp + side * sg * (w + 1.2)
						add_light(Vector3(q.x, 9.0, q.y), Color(0.85, 0.9, 1.0), false, 1.0, 0.0021)
						add_solid(Vector3(q.x, 4.5, q.y), Vector3(0.28, 9.0, 0.28), 0.0, Color(0.22, 0.22, 0.24))
					lamp_s += 32.0
			seg_a = seg_b
			s = s2
		if run_a.distance_to(seg_a) > 40.0:
			add_traffic(run_a, seg_a, 1.1)
			add_people(run_a, seg_a, w + 2.5)
		# lit billboards along the highway, on alternating sides
		var bs := s0 + 90.0
		var side_k := 1.0
		while bs < s1 - 40.0:
			var bp := _point_at(pts, bs)
			var bd := (_point_at(pts, bs + 5.0) - bp).normalized()
			var nrm := Vector2(-bd.y, bd.x) * side_k
			var q: Vector2 = bp + nrm * (w + 7.0)
			if building_at(q.x, q.y) < 0 and water_dist(q.x, q.y) > 4.0 and not is_reserved(q.x, q.y, 3.0):
				add_detail(Vector3(q.x, 5.0, q.y), Vector3(0.5, 10.0, 0.5), 0.0, Color(0.3, 0.3, 0.32))
				var board := MeshInstance3D.new()
				board.mesh = Fx.cube(Vector3(9.0, 4.2, 0.3))
				board.material_override = Fx.glow(BILLBOARD[rng.randi() % BILLBOARD.size()], 1.1)
				board.position = Vector3(q.x, 11.6, q.y)
				board.rotation.y = atan2(bd.x, bd.y) + PI * 0.5
				board.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
				add_child(board)
				add_footprint(q, Vector2(4.5, 0.5), -board.rotation.y, 14.0, 2, "рекламный щит")
			side_k = -side_k
			bs += rng.randf_range(260.0, 360.0)


func _build_rail(r: Dictionary, st: Dictionary) -> void:
	var pts: PackedVector2Array = r.pts
	var spans := _crossings(pts)
	var spec: Dictionary = r.get("bridge", {})
	for sp in spans:
		var bd: Dictionary = Landmarks.bridge(self, _point_at(pts, sp[0]), _point_at(pts, sp[1]), "rail", String(spec.get("name", "железнодорожный мост")), bool(spec.get("target", false)))
		built_bridges.append(bd)
	# height profile: the rail deck on the bridges, 90 m ramps down to the ground
	var total := 0.0
	for i in pts.size() - 1:
		total += pts[i].distance_to(pts[i + 1])
	var track := PackedVector3Array()
	var lens := PackedFloat32Array()
	var s := 0.0
	var gravel := Color(0.2, 0.19, 0.18)
	var steel := Color(0.55, 0.55, 0.58)
	var prev := Vector3.ZERO
	while s <= total + 0.01:
		var p := _point_at(pts, s)
		var y := 0.0
		for sp in spans:
			var d := 0.0
			if s < float(sp[0]):
				d = float(sp[0]) - s
			elif s > float(sp[1]):
				d = s - float(sp[1])
			y = maxf(y, Landmarks.RAIL_DECK * clampf(1.0 - d / 90.0, 0.0, 1.0))
		var cur := Vector3(p.x, y, p.y)
		if not track.is_empty():
			var on_bridge := false
			for sp in spans:
				if s > float(sp[0]) + 1.0 and s - 8.0 < float(sp[1]) - 1.0:
					on_bridge = true
			var a := Vector2(prev.x, prev.z)
			var b := Vector2(cur.x, cur.z)
			if not on_bridge and a.distance_to(b) > 0.3:
				var yy := maxf(prev.y, cur.y)
				if yy > 0.4:
					# embankment under the ramp
					var mid := (a + b) * 0.5
					add_solid(Vector3(mid.x, yy * 0.5, mid.y), Vector3(5.0, yy, a.distance_to(b) + 0.4), atan2(b.x - a.x, b.y - a.y), Color(0.3, 0.28, 0.26))
				_strip(st, a, b, 2.6, 0.07 + yy, gravel)
				var dn := (b - a).normalized()
				var side := Vector2(-dn.y, dn.x)
				for sg in [-0.75, 0.75]:
					_strip(st, a + side * sg, b + side * sg, 0.1, 0.12 + yy, steel)
		track.append(cur)
		lens.append(s)
		prev = cur
		if s >= total:
			break
		s = minf(s + 8.0, total)
	tracks.append({"pts": track, "len": lens, "trains": int(r.get("trains", 1)), "cars": int(r.get("cars", 7))})


# --- Footprints ----------------------------------------------------------------------------------
func _cell_key(ix: int, iz: int) -> int:
	return iz * 1000 + ix


func _register(c: Vector2, half: Vector2, rot: float, h: float, kind: int, fname: String, ref: Vector2i, roof: Vector2i) -> int:
	var i := fp_center.size()
	fp_center.append(Vector3(c.x, h, c.y))
	fp_half.append(half)
	fp_rot.append(rot)
	fp_kind.append(kind)
	fp_damaged.append(0)
	fp_box.append(Vector2.ZERO)
	fp_crush.append(0.0)
	fp_hidden.append(0)
	fp_ref.append(ref)
	fp_roof.append(roof)
	if fname != "":
		fp_name[i] = fname
	var r := half.length()
	var x0 := int(floor((c.x - r + HALF) / FCELL))
	var x1 := int(floor((c.x + r + HALF) / FCELL))
	var z0 := int(floor((c.y - r + HALF) / FCELL))
	var z1 := int(floor((c.y + r + HALF) / FCELL))
	for iz in range(z0, z1 + 1):
		for ix in range(x0, x1 + 1):
			var k := _cell_key(ix, iz)
			if not fp_cells.has(k):
				fp_cells[k] = []
			(fp_cells[k] as Array).append(i)
			if ix >= 0 and iz >= 0 and ix < FN and iz < FN:
				hmax[iz * FN + ix] = maxf(hmax[iz * FN + ix], h)
	return i


## A visible building (unit cube scaled + rotated) with an optional pitched roof.
func add_building(c: Vector2, half: Vector2, rot: float, h: float, style: int, col: Color, kind := 0, roof_h := 0.0, roof_col := Color(0.45, 0.2, 0.15), fname := "") -> int:
	var basis := Basis(Vector3.UP, -rot) * Basis.from_scale(Vector3(half.x * 2.0, h, half.y * 2.0))
	var ref := b_build.add(Transform3D(basis, Vector3(c.x, h * 0.5, c.y)), col, Color(0.0, rng.randf(), style / 10.0, 0.0))
	var roof := Vector2i(-1, -1)
	if roof_h > 0.0:
		var rb: Basis
		if half.x > half.y:
			rb = Basis(Vector3.UP, -rot + PI * 0.5) * Basis.from_scale(Vector3(half.y * 2.0, roof_h, half.x * 2.0))
		else:
			rb = Basis(Vector3.UP, -rot) * Basis.from_scale(Vector3(half.x * 2.0, roof_h, half.y * 2.0))
		roof = b_roof.add(Transform3D(rb, Vector3(c.x, h + roof_h * 0.5, c.y)), roof_col, Color(0.0, rng.randf(), 0.7, 0.0))
	var i := _register(c, half, rot, h + roof_h * 0.6, kind, fname, ref, roof)
	fp_box[i] = Vector2(h, roof_h)
	return i


## Invisible footprint for individually modelled landmarks.
func add_footprint(c: Vector2, half: Vector2, rot: float, h: float, kind := 2, fname := "") -> int:
	return _register(c, half, rot, h, kind, fname, Vector2i(-1, -1), Vector2i(-1, -1))


## Decorative box using the building shader (no collision), e.g. rooftop machine rooms.
func add_prop_box(center: Vector3, size: Vector3, rot: float, col: Color, style := 6) -> Vector2i:
	var basis := Basis(Vector3.UP, -rot) * Basis.from_scale(size)
	return b_build.add(Transform3D(basis, center), col, Color(0.0, rng.randf(), style / 10.0, 0.0))


func add_solid(center: Vector3, size: Vector3, rot: float, col: Color) -> void:
	b_props.add(Transform3D(Basis(Vector3.UP, -rot) * Basis.from_scale(size), center), col)


func add_cyl(base: Vector3, r: float, h: float, col: Color) -> Vector2i:
	return b_cyl.add(Transform3D(Basis.from_scale(Vector3(r * 2.0, h, r * 2.0)), base + Vector3(0, h * 0.5, 0)), col)


## A small unlit prop box (AC units, slides, pylons …).
func add_detail(center: Vector3, size: Vector3, rot: float, col: Color) -> Vector2i:
	return b_detail.add(Transform3D(Basis(Vector3.UP, -rot) * Basis.from_scale(size), center), col)


## A glowing sign / shop front / neon strip.
func add_neon(center: Vector3, size: Vector3, rot: float, col: Color) -> Vector2i:
	return b_neon.add(Transform3D(Basis(Vector3.UP, -rot) * Basis.from_scale(size), center), col)


## Smoke rising from a chimney top (a limited number per city).
func add_smoke(top: Vector3, dark := true) -> void:
	if smoke_budget <= 0:
		return
	smoke_budget -= 1
	var sm := CPUParticles3D.new()
	sm.mesh = Fx.sphere(1.0, 6)
	sm.material_override = Fx.smoke_mat()
	sm.amount = 14
	sm.lifetime = 7.0
	sm.direction = Vector3.UP
	sm.spread = 10.0
	sm.initial_velocity_min = 3.0
	sm.initial_velocity_max = 5.0
	sm.gravity = Vector3(1.6, 0.5, 0.6)
	sm.scale_amount_min = 2.5
	sm.scale_amount_max = 6.0
	var g := Gradient.new()
	g.set_color(0, Color(0.45, 0.43, 0.42, 0.45) if dark else Color(0.8, 0.8, 0.82, 0.35))
	g.set_color(1, Color(0.4, 0.4, 0.42, 0.0))
	sm.color_ramp = g
	sm.position = top
	add_child(sm)


## A parked car at the kerb, its nose towards world direction `dir`.
func add_parked(p: Vector2, dir: Vector2, col: Color) -> void:
	b_parked.add(Transform3D(Basis(Vector3.UP, atan2(-dir.x, -dir.y)), Vector3(p.x, 0.0, p.y)), col)


## Glues a prop to building `i`: "wall" pieces shrink with the collapsed floors, "roof" pieces
## are gone while the building is damaged.
func attach(i: int, batch: Batch, ref: Vector2i, roof: bool) -> void:
	if i < 0 or ref.x < 0:
		return
	if not fp_attach.has(i):
		fp_attach[i] = []
	(fp_attach[i] as Array).append([batch, ref, batch.get_xform(ref), roof])


func add_light(pos: Vector3, col: Color, blink := false, base := 1.0, k := 0.0025) -> void:
	b_lights.add(Transform3D(Basis(), pos), col, Color(rng.randf(), 1.0 if blink else 0.0, base, k))


## Two opposite streams of car lights between a and b.
func add_traffic(a: Vector2, b: Vector2, density := 1.0, y := 0.0) -> void:
	var d := b - a
	var length := d.length()
	if length < 40.0:
		return
	var dir := d / length
	var side := Vector2(-dir.y, dir.x)
	var n := maxi(1, int(length / 38.0 * density))
	for lane in 2:
		var from := a if lane == 0 else b
		var to_dir := dir if lane == 0 else -dir
		var off := side * (2.6 if lane == 0 else -2.6)
		var basis := Basis.looking_at(Vector3(to_dir.x, 0, to_dir.y), Vector3.UP)
		var col := Color(1.0, 0.93, 0.78) if lane == 0 else Color(1.0, 0.12, 0.07)
		for i in n:
			var o := from + off
			var xf := Transform3D(basis, Vector3(o.x, y, o.y))
			var cd := Color(rng.randf_range(9.0, 16.0), length, rng.randf(), 0.0)
			b_traffic.add(xf, col, cd)
			b_cars.add(xf, CAR_PAINT[rng.randi() % CAR_PAINT.size()], cd)


## Pedestrians walking both ways along the sidewalks of a street segment.
func add_people(a: Vector2, b: Vector2, sidewalk: float, y := 0.0) -> void:
	var d := b - a
	var length := d.length()
	if length < 30.0:
		return
	var dir := d / length
	var side := Vector2(-dir.y, dir.x)
	for s in [-1.0, 1.0]:
		var n := int(length / 22.0)
		for i in n:
			var fwd := rng.randf() < 0.5
			var start: Vector2 = a if fwd else b
			var from: Vector2 = start + side * float(s) * (sidewalk + rng.randf_range(-0.8, 0.8))
			var to_dir: Vector2 = dir if fwd else -dir
			var basis := Basis.looking_at(Vector3(to_dir.x, 0, to_dir.y), Vector3.UP)
			var cd := Color(rng.randf_range(1.1, 1.8), length, rng.randf(), rng.randf())
			b_people.add(Transform3D(basis, Vector3(from.x, y, from.y)), CLOTHES[rng.randi() % CLOTHES.size()], cd)


